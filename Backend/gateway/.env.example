# Cada valor debe ser IDÉNTICO al del servicio indicado (se copian de su .env)
JWT_SIGNING=
GW_AUTH=
GW_CLIENTS=
GW_INVENTORY=
GW_ORDERS=
GW_PAYMENTS=
# GW_GRAPHQL es nuevo: el servicio graphql usará el mismo valor
GW_GRAPHQL=
